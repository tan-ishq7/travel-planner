PORT=3001
MONGO_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/travel-planner

# Your Supabase project URL (no trailing slash)
SUPABASE_URL=https://your-project-id.supabase.co

# Comma-separated list of allowed frontend origins (Vercel URL + localhost)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

ADMIN_EMAILS=admin@example.com

# Use Live keys (`rzp_live_...`) in production. For testing, use `rzp_test_...`.
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
