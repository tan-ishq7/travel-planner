# Local development — point to local backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# ⚠️  PRODUCTION (Vercel) — set this to your Render backend URL, e.g.:
# NEXT_PUBLIC_API_URL=https://your-backend-name.onrender.com
# Do NOT leave this as localhost on Vercel or bookings will silently fail.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Must match the deployed frontend URL (used for Google OAuth redirect)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Use a Live key (`rzp_live_...`) in production. For testing, use `rzp_test_...`.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

GROQ_API_KEY=your-groq-api-key
