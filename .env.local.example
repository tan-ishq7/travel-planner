# =============================================================================
# Travel Planner — Frontend Environment (Next.js)
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND + SITE URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# AI PROVIDER  (Yatra AI chatbot)
# -----------------------------------------------------------------------------
# Choose ONE provider. Only that provider's API key is required.
#
#   [1] claude  -> Anthropic Claude (recommended if you have a Claude key)
#   [2] groq    -> Groq (llama models, cheapest / fastest)
#
AI_PROVIDER=claude


# -----------------------------------------------------------------------------
# AI TASK TIERS
# -----------------------------------------------------------------------------
# Every chat request runs on one of two tiers, chosen per request via the
# `taskType` field ("fast" or "smart", default "fast"). Each tier maps to a
# model per provider. Cheap on light tasks, powerful when it matters.
#
#   "fast"  -> short chat replies, low latency, cheap
#             (default for Yatra AI, and what you want on a $4 budget)
#
#   "smart" -> deeper planning, longer reasoning, higher cost
#             (use for future features: itinerary generator, day-by-day
#             plans, group budget optimization, etc.)
#
# For the current $4 credit setup we keep BOTH tiers on Haiku 4.5 — the
# app never gets accidentally expensive. Upgrade `MODEL_CLAUDE_SMART` later
# once you're ready to spend more per query.

# --- [1] Claude models ---
# Options (cheap -> expensive):
#   claude-haiku-4-5    ($1/M in,  $5/M out)  — recommended for $4 budget
#   claude-sonnet-5     ($3/M in, $15/M out)
#   claude-opus-4-7     ($5/M in, $25/M out)
#   claude-opus-4-8     ($5/M in, $25/M out)  — most capable Opus
MODEL_CLAUDE_FAST=claude-haiku-4-5
MODEL_CLAUDE_SMART=claude-haiku-4-5

# --- [1a] Optional: Claude reasoning effort per tier ---
# Values: low | medium | high | xhigh | max   (blank = default)
# ONLY works on Opus / Sonnet 4.6+. Haiku ignores this — leave blank for Haiku
# or the request will 400.
# Example: run Opus 4.7 with low effort for cheaper (but still Opus-quality)
# planning:  MODEL_CLAUDE_SMART=claude-opus-4-7   CLAUDE_EFFORT_SMART=low
CLAUDE_EFFORT_FAST=
CLAUDE_EFFORT_SMART=

# --- [2] Groq models ---
# Options:
#   llama-3.1-8b-instant           — fastest, cheapest
#   llama-3.3-70b-versatile        — smarter, slower
MODEL_GROQ_FAST=llama-3.1-8b-instant
MODEL_GROQ_SMART=llama-3.3-70b-versatile


# --- API keys ---
# You only need the key for the provider you set in AI_PROVIDER above.
# Anthropic: https://console.anthropic.com/settings/keys   (sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Groq: https://console.groq.com/keys                       (gsk_...)
GROQ_API_KEY=gsk_your-groq-key


# -----------------------------------------------------------------------------
# SUPABASE  (auth: login / register / OAuth)
# -----------------------------------------------------------------------------
# Get from: https://supabase.com -> your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key


# -----------------------------------------------------------------------------
# RAZORPAY  (payments)
# -----------------------------------------------------------------------------
# Get from: https://dashboard.razorpay.com/app/keys
# Use `rzp_test_...` for local dev, `rzp_live_...` in production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
